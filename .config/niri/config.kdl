input {
    touchpad {
        tap
        natural-scroll
    }
}
cursor {
    xcursor-size 20
}
output "eDP-1" {
    scale 2.0
}
hotkey-overlay {
    skip-at-startup
}
overview {
    zoom 1
}

// 优化1：缩短动画 duration，减少 GPU 着色器执行时间
animations {
    workspace-switch {
        spring damping-ratio=0.62 stiffness=400 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.62 stiffness=400 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.62 stiffness=400 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.75 stiffness=500 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.5 stiffness=500 epsilon=0.0001
    }
    exit-confirmation-open-close {
        spring damping-ratio=0.5 stiffness=500 epsilon=0.0001
    }
    screenshot-ui-open {
        spring damping-ratio=0.75 stiffness=500 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=0.75 stiffness=500 epsilon=0.0001
    }
    window-close {
        duration-ms 400
        curve "linear"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float progress = niri_clamped_progress * niri_clamped_progress;
                vec2 coords = (coords_geo.xy - vec2(0.0, 1.0)) * size_geo.xy;
                float angle = progress * 0.7;
                mat2 rotate = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
                coords = rotate * coords;
                coords += vec2(progress * 0.15, progress * 0.15) * size_geo.xy;
                coords_geo = vec3(coords / size_geo.xy + vec2(0.0, 1.0), 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * (1.0 - niri_clamped_progress);
            }
        "
    }
    window-open {
        duration-ms 400
        curve "linear"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float inv = 1.0 - niri_clamped_progress;
                float progress = inv * inv;
                vec2 coords = (coords_geo.xy - vec2(0.0, 1.0)) * size_geo.xy;
                float angle = progress * 0.7;
                mat2 rotate = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
                coords = rotate * coords;
                coords += vec2(progress * 0.15, progress * 0.15) * size_geo.xy;
                coords_geo = vec3(coords / size_geo.xy + vec2(0.0, 1.0), 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * niri_clamped_progress;
            }
        "
    }
}

layout {
    background-color "transparent"
    gaps 8
    struts {
        right -2
    }
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
    }
    default-column-width {
        proportion 0.5
    }
    focus-ring {
        width 1.5
        active-gradient from="#ef4444cc" to="#e879f9cc" angle=90 in="oklch longer hue" relative-to="workspace-view"
        inactive-color "#50505020"
    }
    border {
        off
    }
    shadow {
        softness 35
        spread 6
        offset x=0 y=6
        color "#0007"
    }
}

blur {
    passes 2
    offset 1.8
    noise 0.03
    saturation 1.3
}

window-rule {
    open-maximized false
    default-column-width {
        proportion 0.5
    }
    default-window-height {
        proportion 1.0
    }
    open-maximized-to-edges false
    opacity 0.85
    background-effect {
        blur false
    }
}
window-rule {
    match app-id="^zen$"
    open-maximized true
    background-effect {
        blur true
    }
}
window-rule {
    match app-id="^foot$"
    open-maximized false
    default-column-width {
        proportion 0.5
    }
    background-effect {
        blur true
    }
}
window-rule {
    match app-id="^foot$" title="^musicfox$"
    opacity 0.95
    default-window-height {
        proportion 1.0
    }
}
window-rule {
    match app-id="^spacefm"
    opacity 0.92
    background-effect {
        blur true
    }
}
window-rule {
    match is-window-cast-target=false
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}

layer-rule {
    match namespace="^noctalia-bar"
    background-effect {
        blur true
    }
}
layer-rule {
    match namespace="^fcitx"
    background-effect {
        xray true
        blur true
    }
}
layer-rule {
    match namespace="^noctalia-(notification|dock|osd)$"
    background-effect {
        xray true
        blur true
    }
}
layer-rule {
    match namespace="^noctalia-wallpaper$"
    background-effect {
        blur false
    }
}
layer-rule {
    match namespace="^noctalia-(panel|attached-panel)$"
    background-effect {
        xray false
        blur true
    }
}

switch-events {
    lid-close {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "sessionMenu" "lockAndSuspend"
    }
}
spawn-at-startup "sh" "-c" "sleep 1 && noctalia"
spawn-at-startup "sh" "-c" "sleep 3 && fcitx5"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"

include "binds.kdl"
