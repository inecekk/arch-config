#!/bin/bash
# backuplk - Arch 配置自动备份工具

DOT_SERVICE="dotfiles-backup.service"
WALL_SERVICE="wallpapers-backup.service"

print_help() {
    cat << 'HELP'
backuplk - Arch 配置自动备份工具

用法:
  backuplk          手动备份并显示结果
  backuplk backup   手动备份并显示结果（同默认）
  backuplk dae      备份 dae 代理配置（脱敏处理）
  backuplk system   备份系统配置（fstab/mkinitcpio/boot loader/networkd）
  backuplk pkglist  备份已安装包列表（.md 格式，重装恢复用）
  backuplk pkglist-full  备份完整依赖包列表（含依赖，.md 格式）
  backuplk all      备份所有内容（含自动提交推送）
  backuplk status   查看定时器下次执行时间
  backuplk log      查看完整备份日志
  backuplk help     显示本帮助

备份位置:
  dotfiles 配置 -> https://github.com/inecekk/arch-config
                    (含 niri、foot、fcitx5 等核心配置)
  壁纸          -> https://github.com/inecekk/wallpapers
  backup 脚本   -> ~/.local/bin/backuplk
  定时任务      -> ~/.config/systemd/user/ 下的 timer（每天 13:00 自动执行)
  dae 配置      -> ~/.config/dae/（敏感信息已脱敏）
  系统配置      -> ~/.config/system-backup/（fstab/loader/mkinitcpio/iwd 等）
  包列表        -> ~/.dotfiles/（.md 格式，官方源 + AUR 分开存，每行3个包）

日志查看:
  journalctl --user -u dotfiles-backup.service --no-pager -n 10
  journalctl --user -u wallpapers-backup.service --no-pager -n 10
HELP
}

backup_now() {
    echo "== 触发备份 =="
    systemctl --user start "$DOT_SERVICE" 2>&1
    systemctl --user start "$WALL_SERVICE" 2>&1
    echo "等待备份完成..."
    sleep 3
    echo ""
    echo "== dotfiles 备份日志 =="
    journalctl --user -u "$DOT_SERVICE" --no-pager -n 15 | tail -n 15
    echo ""
    echo "== 壁纸备份日志 =="
    journalctl --user -u "$WALL_SERVICE" --no-pager -n 15 | tail -n 15
}

backup_dae() {
    echo "== 备份 dae 配置 =="
    mkdir -p /tmp/dae-backup
    sudo sed -E 's/(anytls:\/\/|ss:\/\/|vmess:\/\/|vless:\/\/)[^@ ]*/\1[REDACTED]/g; s/uuid:[a-f0-9-]+/uuid:[REDACTED]/g' /etc/dae/config.dae > /tmp/dae-backup/config.dae
    mkdir -p "$HOME/.config/dae"
    cp /tmp/dae-backup/config.dae "$HOME/.config/dae/config.dae"
    rm -f /tmp/dae-backup/config.dae
    rmdir /tmp/dae-backup
    echo "dae 配置已脱敏备份到 ~/.config/dae/config.dae"
}

backup_system() {
    echo "== 备份系统配置 =="
    SYSBK="$HOME/.config/system-backup"
    mkdir -p "$SYSBK/etc" "$SYSBK/boot/loader/entries"

    for f in fstab mkinitcpio.conf locale.conf hostname vconsole.conf; do
        if [ -f "/etc/$f" ]; then
            cp "/etc/$f" "$SYSBK/etc/$f"
            echo "    /etc/$f"
        fi
    done

    mkdir -p "$SYSBK/etc/systemd/network"
    cp /etc/systemd/network/*.network "$SYSBK/etc/systemd/network/" 2>/dev/null && echo "    /etc/systemd/network/*.network"

    if [ -f /etc/iwd/main.conf ]; then
        mkdir -p "$SYSBK/etc/iwd"
        cp /etc/iwd/main.conf "$SYSBK/etc/iwd/main.conf"
        echo "    /etc/iwd/main.conf"
    fi

    if [ -f /etc/systemd/system/disable-wakeup.service ]; then
        mkdir -p "$SYSBK/etc/systemd/system"
        cp /etc/systemd/system/disable-wakeup.service "$SYSBK/etc/systemd/system/disable-wakeup.service"
        echo "    /etc/systemd/system/disable-wakeup.service"
    fi

    if [ -f /boot/loader/loader.conf ]; then
        cp /boot/loader/loader.conf "$SYSBK/boot/loader/loader.conf"
        echo "    /boot/loader/loader.conf"
    fi
    cp /boot/loader/entries/*.conf "$SYSBK/boot/loader/entries/" 2>/dev/null && echo "    /boot/loader/entries/*.conf"

    if [ -f /etc/default/grub ]; then
        mkdir -p "$HOME/.config/grub"
        grep -E "^(GRUB_DEFAULT|GRUB_TIMEOUT|GRUB_CMDLINE)" /etc/default/grub > "$HOME/.config/grub/grub.cfg" 2>/dev/null
        echo "    /etc/default/grub (关键项)"
    fi

    if [ -d /var/lib/iwd ]; then
        echo "    提示: iwd WiFi 密码在 /var/lib/iwd，含明文 PSK 不入库，重装后需手动 iwctl connect"
    fi

    echo "系统配置已备份到 $SYSBK（重装后 install-dotfiles.sh --with-system 恢复）"
}

format_packages_3cols() {
    local input_file="$1"
    local output_file="$2"
    local title="$3"
    
    # Read packages, group by 3
    packages=($(cat "$input_file"))
    total=${#packages[@]}
    
    {
        echo "# $title"
        echo ""
        echo "> 来源: \`pacman -Qqe\`"
        echo "> 更新时间: $(date '+%Y-%m-%d')"
        echo ""
        
        # Group by 3 columns
        for ((i=0; i<total; i+=3)); do
            line=""
            for ((j=0; j<3; j++)); do
                idx=$((i + j))
                if [ $idx -lt $total ]; then
                    printf -v pkg "%-25s" "${packages[$idx]}"
                    line="$line$pkg"
                fi
            done
            echo "$line"
        done
        echo ""
        echo "**总计: $total 个**"
    } > "$output_file"
}

backup_pkglist() {
    echo "== 备份包列表 =="
    mkdir -p "$HOME/.dotfiles"

    # 官方源包
    pacman -Qqen > "$HOME/.dotfiles/pkglist-official.txt"
    # AUR 包
    pacman -Qqem > "$HOME/.dotfiles/pkglist-aur.txt"
    # 合并列表
    cat "$HOME/.dotfiles/pkglist-official.txt" "$HOME/.dotfiles/pkglist-aur.txt" | sort -u > "$HOME/.dotfiles/pkglist-all.txt"

    # 格式化为 markdown (每行3个包)
    format_packages_3cols "$HOME/.dotfiles/pkglist-official.txt" "$HOME/.dotfiles/pkglist-official.md" "官方源包列表"
    format_packages_3cols "$HOME/.dotfiles/pkglist-aur.txt" "$HOME/.dotfiles/pkglist-aur.md" "AUR 包列表"
    
    # 合并列表 markdown
    cat "$HOME/.dotfiles/pkglist-all.txt" > "$HOME/.dotfiles/pkglist-all.md"

    echo "官方源: $(wc -l < "$HOME/.dotfiles/pkglist-official.txt") 个"
    echo "AUR:    $(wc -l < "$HOME/.dotfiles/pkglist-aur.txt") 个"
    echo "已备份到 ~/.dotfiles/ (md 格式，每行3个包)"
}

backup_pkglist_full() {
    echo "== 备份完整依赖包列表 =="
    mkdir -p "$HOME/.dotfiles"
    pacman -Qq > "$HOME/.dotfiles/pkglist-full.md"
    echo "完整依赖列表: $(wc -l < "$HOME/.dotfiles/pkglist-full.md") 个"
    echo "已备份到 ~/.dotfiles/pkglist-full.md"
}

show_status() {
    echo "== 定时任务状态 =="
    systemctl --user list-timers | grep -E "backup|NEXT" || echo "未找到备份定时器"
}

show_log() {
    echo "== dotfiles 备份日志（最近 20 行）=="
    journalctl --user -u "$DOT_SERVICE" --no-pager -n 20
    echo ""
    echo "== 壁纸备份日志（最近 20 行）=="
    journalctl --user -u "$WALL_SERVICE" --no-pager -n 20
}

auto_commit_push() {
    echo "== 自动提交并推送 =="
    cd "$HOME"
    git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" add \
        .dotfiles/pkglist-*.md \
        .dotfiles/pkglist-*.txt \
        .config/dae/ \
        .config/system-backup/ \
        .local/bin/backuplk \
        2>/dev/null
    if git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" diff --cached --quiet; then
        echo "无新变更，跳过提交"
    else
        git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" commit -m "feat: 自动备份更新 $(date '+%Y-%m-%d %H:%M')" 2>/dev/null
        git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" push origin main 2>&1 | tail -3
    fi
}

case "${1:-backup}" in
    backup|"")       backup_now ;;
    status)          show_status ;;
    log)             show_log ;;
    dae)             backup_dae ;;
    system)          backup_system ;;
    pkglist)         backup_pkglist ;;
    pkglist-full)    backup_pkglist_full ;;
    all)             backup_now; backup_dae; backup_system; backup_pkglist; backup_pkglist_full; auto_commit_push ;;
    help|-h|--help)  print_help ;;
    *) echo "未知参数: $1（可用: backup / status / log / dae / system / pkglist / pkglist-full / all / help）" ;;
esac
