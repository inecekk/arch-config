#!/usr/bin/env bash
# brightness-safe: 背光控制脚本
# 注意: 本机 amdgpu_bl1 是 raw 类型背光，写入 100% (65535) 时 PWM 溢出翻转，
#       实测 100% 比 0% 还暗（AMD dc 驱动在 RDNA2 核显 + eDP 上的已知边界问题）。
#       90% 实测最亮，95% 安全，99% 实测仍会变暗；上限锁 98% 是为了避开 65535 那个雷。
#       若 98% 也出现变暗，把 MAX_SAFE 继续回落即可。
# 用法: brightness-safe up|down|set [percent]

DEV="amdgpu_bl1"
MAX_HW=65535
MAX_SAFE=98  # 上限百分比（100% 会 PWM 溢出变暗，实测 99% 仍会变暗，锁 98%）

pct_to_val() { echo $((MAX_HW * $1 / 100)); }

cur_pct=$(brightnessctl -d "$DEV" get 2>/dev/null | awk -v max="$MAX_HW" '{printf "%d", $1*100/max}')

case "$1" in
  up)
    new=$((cur_pct + 5 > MAX_SAFE ? MAX_SAFE : cur_pct + 5))
    brightnessctl -d "$DEV" set "$(pct_to_val "$new")"
    ;;
  down)
    new=$((cur_pct - 5 < 0 ? 0 : cur_pct - 5))
    brightnessctl -d "$DEV" set "$(pct_to_val "$new")"
    ;;
  set)
    new=$2
    [ -z "$new" ] && new=$cur_pct
    new=$((new > MAX_SAFE ? MAX_SAFE : new))
    new=$((new < 0 ? 0 : new))
    brightnessctl -d "$DEV" set "$(pct_to_val "$new")"
    ;;
  *)
    echo "当前亮度: ${cur_pct}% (上限 ${MAX_SAFE}%)"
    ;;
esac
